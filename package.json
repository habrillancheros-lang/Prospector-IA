{
  "name": "company-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "dataset:profile": "node scripts/profile-dataset.ts",
    "dataset:verify": "node scripts/verify-dataset.ts",
    "dataset:vocabulary": "node scripts/build-vocabulary.ts",
    "dataset:import": "node --env-file=.env.local scripts/import-companies.ts",
    "test:dataset": "node --test lib/companies/normalize.test.ts",
    "test:core": "node --test lib/companies/*.test.ts",
    "test:chats": "node --test lib/chats/*.test.ts",
    "core:try": "node --env-file=.env.local scripts/try-core.ts",
    "mcp:try": "node --env-file=.env.local scripts/try-mcp.ts",
    "agent:try": "node --env-file=.env.local scripts/try-agent.ts",
    "agent:try-names": "node --env-file=.env.local scripts/try-company-names.ts",
    "eval:companies": "eve eval companies --url http://localhost:3000 --strict",
    "test:evals": "node --test evals/companies/grounding.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "@assistant-ui/eve": "0.0.20",
    "@assistant-ui/react": "0.15.23",
    "@assistant-ui/react-markdown": "0.14.18",
    "@base-ui/react": "1.8.0",
    "@modelcontextprotocol/server": "2.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.3",
    "eve": "0.56.0",
    "lucide-react": "1.51.0",
    "mcp-handler": "2.1.1",
    "mongodb": "7.7.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "tw-shimmer": "0.4.13",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@assistant-ui/next": "0.0.23",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "microsandbox": "^0.5.10",
    "oxfmt": "0.68.0",
    "oxlint": "1.86.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@10.9.2"
}
