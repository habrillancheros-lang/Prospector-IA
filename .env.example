# Standard Z.ai API key for direct glm-5.3-flash Chat Completions.
GLM_API_KEY=

# Voyage API key for semantic company search (voyage-4-lite).
VOYAGE_API_KEY=

# Atlas read-only application credential.
MONGODB_URI=
MONGODB_DB=

# Separate credential for the offline import script (writes and index management).
MONGODB_IMPORT_URI=

# Chat persistence: read/write + index permissions on chats and chat_events.
# Local development falls back to MONGODB_IMPORT_URI if CHAT_URI is unset.
# Required in production; use a dedicated chat credential, not MONGODB_URI.
# Can use the same cluster/database as companies, with a different MongoDB user.
MONGODB_CHAT_URI=
# Leave unset when chat collections share MONGODB_DB; no new database is needed.
MONGODB_CHAT_DB=

# Shared bearer credential for the three read-only company tools.
MCP_API_KEY=
# Complete MCP endpoint; production requires https://<public-demo-host>/mcp.
# The default below is for local development only.
MCP_SERVER_URL=http://localhost:3000/mcp
